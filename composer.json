{
  "name": "djia/php-analytic-tracker",
  "description": "PHP integration library for sending signed server events to the Commerce Intelligence collector",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=7.4",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^9.6",
    "rector/rector": "^2.8"
  },
  "autoload": {
    "psr-4": {
      "CommerceIntelligence\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CommerceIntelligence\\Sdk\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
